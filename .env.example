# API 提供商配置：默认 DeepSeek；可换成任意 OpenAI 兼容接口。
LLM_MODE=api
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=请填写你的API密钥
LLM_MODEL=deepseek-chat
# 可选：网络使用自签名证书时，填写对应根证书 PEM 文件路径。
LLM_CA_BUNDLE=

# API 裁判配置：留空时复用上面的教师 API。
JUDGE_API_BASE=
JUDGE_API_KEY=
JUDGE_MODEL=
JUDGE_MIN_CONFIDENCE=0.95

# 本地模型配置：仅当 LLM_MODE=local 时生效。
LOCAL_MODEL_PATH=path/to/Qwen2.5-1.5B-Instruct
LOCAL_ADAPTER_PATH=
LOCAL_THREADS=8
LOCAL_MAX_NEW_TOKENS=256

# MySQL 配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=请填写你的MySQL密码
MYSQL_DATABASE=ecommerce_text_to_sql
